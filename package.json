{
  "name": "bill-master",
  "private": true,
  "version": "0.0.42",
  "description": "A modern offline billing and printing application.",
  "author": "BillMaster",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "electron": "electron electron/main.js",
    "start": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run electron\"",
    "build": "vite build",
    "dist": "npm run build && electron-builder --win",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "main": "electron/main.js",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "lucide-react": "^1.24.0",
    "pdf-to-printer": "^5.8.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^26.1.0",
    "vite": "^8.1.1",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.billmaster.desktop",
    "productName": "BillMaster",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/pdf-to-printer/dist/*.exe"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "deleteAppDataOnUninstall": false
    }
  }
}
